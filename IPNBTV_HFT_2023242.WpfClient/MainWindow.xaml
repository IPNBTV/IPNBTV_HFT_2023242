<Window x:Class="IPNBTV_HFT_2023242.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:IPNBTV_HFT_2023242.WpfClient.ViewModels"
        xmlns:utils="clr-namespace:IPNBTV_HFT_2023242.WpfClient.Utils"
        Title="Car Rental Manager" Height="650" Width="1150" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <utils:IdToImageConverter x:Key="IdToImageConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vms:MainWindowViewModel />
    </Window.DataContext>

    <TabControl Margin="10">

        <TabItem Header="🚗 Cars" FontSize="16">
            <Grid Background="#F5F5F5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" 
                AutoGenerateColumns="False" IsReadOnly="True" Margin="15" SelectionMode="Single" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="*"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                        <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Automatic" Binding="{Binding IsAutomatic}" Width="80"/>
                        <DataGridTextColumn Header="Rental Shop" Binding="{Binding RentalShop}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="10,15,15,15">
                    <Button Content="➕ Add Car" Command="{Binding CreateCarCommand}" Margin="0,0,0,10" Padding="10" Background="#FF4CAF50" Foreground="White"/>
                    <Button Content="✏️ Edit Car" Command="{Binding UpdateCarCommand}" Margin="0,0,0,10" Padding="10" Background="#FF2196F3" Foreground="White"/>
                    <Button Content="🗑️ Delete Car" Command="{Binding DeleteCarCommand}" Padding="10" Background="#FFF44336" Foreground="White"/>

                    <Border Margin="0,20,0,0" BorderBrush="#DDDDDD" BorderThickness="1" Background="White" CornerRadius="5" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCar}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Image Source="{Binding SelectedCar.Id, Converter={StaticResource IdToImageConverter}}" 
                               MaxHeight="250" Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="🏢 Rental Shops" FontSize="16">
            <Grid Background="#F5F5F5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" ItemsSource="{Binding RentalShops}" SelectedItem="{Binding SelectedShop}" 
                AutoGenerateColumns="False" IsReadOnly="True" Margin="15" SelectionMode="Single" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Shop Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="1.5*"/>
                        <DataGridTextColumn Header="Phone Number" Binding="{Binding Phone}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="10,15,15,15">
                    <Button Content="➕ Add Shop" Command="{Binding CreateShopCommand}" Margin="0,0,0,10" Padding="10" Background="#FF4CAF50" Foreground="White"/>
                    <Button Content="✏️ Edit Shop" Command="{Binding UpdateShopCommand}" Margin="0,0,0,10" Padding="10" Background="#FF2196F3" Foreground="White"/>
                    <Button Content="🗑️ Delete Shop" Command="{Binding DeleteShopCommand}" Padding="10" Background="#FFF44336" Foreground="White"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="📅 Rental Events" FontSize="16">
            <Grid Background="#F5F5F5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" ItemsSource="{Binding RentalEvents}" SelectedItem="{Binding SelectedEvent}" 
          AutoGenerateColumns="False" IsReadOnly="True" Margin="15" SelectionMode="Single" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Car ID" Binding="{Binding CarId}" Width="60"/>
                        <DataGridTextColumn Header="Car Details" Binding="{Binding Car}" Width="1.5*"/>
                        <DataGridTextColumn Header="Rental Date" 
                            Binding="{Binding RentalDate, StringFormat='{}{0:yyyy-MM-dd}'}" 
                            Width="*"/>
                        <DataGridTextColumn Header="Return Date" 
                            Binding="{Binding ReturnDate, StringFormat='{}{0:yyyy-MM-dd}'}" 
                            Width="*"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="10,15,15,15">
                    <Button Content="➕ Add Event" Command="{Binding CreateEventCommand}" Margin="0,0,0,10" Padding="10" Background="#FF4CAF50" Foreground="White"/>
                    <Button Content="✏️ Edit Event" Command="{Binding UpdateEventCommand}" Margin="0,0,0,10" Padding="10" Background="#FF2196F3" Foreground="White"/>
                    <Button Content="🗑️ Delete Event" Command="{Binding DeleteEventCommand}" Padding="10" Background="#FFF44336" Foreground="White"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="📊 Statistics &amp; Queries" FontSize="16">
            <Grid Background="#F5F5F5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="20,20,10,20">
                    <StackPanel>

                        <Button Content="1. Get Customers with Automatic Transmission" Command="{Binding GetCustomersWithAutomaticTransmissionCommand}" Padding="10" Margin="0,0,0,20" Background="#FF9C27B0" Foreground="White"/>

                        <GroupBox Header="2. Most Rented Car in Shop" Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <Label Content="Shop ID:"/>
                                <TextBox Text="{Binding SearchShopId}" Margin="0,0,0,10"/>
                                <Button Content="Run Query" Command="{Binding GetMostRentedCarInRentalShopCommand}" Padding="5" Background="#FF009688" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="3. Event count for Car in Shop" Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <Label Content="Car ID:"/>
                                <TextBox Text="{Binding SearchCarId}" Margin="0,0,0,5"/>
                                <Label Content="Shop ID:"/>
                                <TextBox Text="{Binding SearchShopId}" Margin="0,0,0,10"/>
                                <Button Content="Run Query" Command="{Binding GetNumberOfRentalEventsForCarInShopCommand}" Padding="5" Background="#FF009688" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="4. Order By Most Rentals" Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <Label Content="Start Date (yyyy-MM-dd):"/>
                                <TextBox Text="{Binding SearchStartDate, StringFormat='{}{0:yyyy-MM-dd}'}" Margin="0,0,0,5"/>
                                <Label Content="End Date (yyyy-MM-dd):"/>
                                <TextBox Text="{Binding SearchEndDate, StringFormat='{}{0:yyyy-MM-dd}'}" Margin="0,0,0,10"/>
                                <Button Content="Run Query" Command="{Binding OrderByMostRentalsCommand}" Padding="5" Background="#FF009688" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="5. Rental Shops with Car Color" Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <Label Content="Color:"/>
                                <TextBox Text="{Binding SearchColor}" Margin="0,0,0,10"/>
                                <Button Content="Run Query" Command="{Binding GetRentalShopsWithCarColorCommand}" Padding="5" Background="#FF009688" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <GroupBox Grid.Column="1" Header="Query Results" Margin="10,15,20,20" FontSize="18" FontWeight="Bold" Foreground="#333333">
                    <Border Background="White" CornerRadius="5" Padding="15" Margin="0,10,0,0" BorderBrush="#DDDDDD" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding QueryResult}" 
                                       FontSize="16" 
                                       FontWeight="Normal" 
                                       TextWrapping="Wrap" 
                                       Foreground="#111111" 
                                       FontFamily="Consolas" />
                        </ScrollViewer>
                    </Border>
                </GroupBox>

            </Grid>
        </TabItem>
    </TabControl>
</Window>