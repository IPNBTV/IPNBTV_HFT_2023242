<Window x:Class="IPNBTV_HFT_2023242.WpfClient.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Editor" Height="310" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="15">
        <Label Content="Car ID" FontWeight="Bold"/>
        <TextBox Text="{Binding CarId}" Margin="0,0,0,5"/>

        <Label Content="Rental Date (yyyy-MM-dd)" FontWeight="Bold"/>
        <TextBox Text="{Binding RentalDate, StringFormat=yyyy-MM-dd}" Margin="0,0,0,5"/>

        <Label Content="Return Date (yyyy-MM-dd)" FontWeight="Bold"/>
        <TextBox Text="{Binding ReturnDate, StringFormat=yyyy-MM-dd}" Margin="0,0,0,5"/>

        <Label Content="Customer Name" FontWeight="Bold"/>
        <TextBox Text="{Binding CustomerName}" Margin="0,0,0,15"/>

        <Button Content="Save" FontSize="16" Padding="5" Click="SaveButton_Click" Background="#FF4CAF50" Foreground="White"/>
    </StackPanel>
</Window>