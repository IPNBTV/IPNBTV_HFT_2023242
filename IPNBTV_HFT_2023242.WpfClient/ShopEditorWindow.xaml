<Window x:Class="IPNBTV_HFT_2023242.WpfClient.ShopEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop Editor" Height="310" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="15">
        <Label Content="Name" FontWeight="Bold"/>
        <TextBox Text="{Binding Name}" Margin="0,0,0,5"/>

        <Label Content="City" FontWeight="Bold"/>
        <TextBox Text="{Binding City}" Margin="0,0,0,5"/>

        <Label Content="Address" FontWeight="Bold"/>
        <TextBox Text="{Binding Address}" Margin="0,0,0,5"/>

        <Label Content="Phone" FontWeight="Bold"/>
        <TextBox Text="{Binding Phone}" Margin="0,0,0,15"/>

        <Button Content="Save" FontSize="16" Padding="5" Click="SaveButton_Click" Background="#FF4CAF50" Foreground="White"/>
    </StackPanel>
</Window>